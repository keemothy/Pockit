# Get from https://console.anthropic.com/ — used by the AI Chatbot feature.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Get these from https://dashboard.plaid.com/ (use Sandbox for local testing).
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Supabase Dashboard -> Connect. The service-role key is server-only: never expose it in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
